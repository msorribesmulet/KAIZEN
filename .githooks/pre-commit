#!/bin/sh
#
# Aborta el commit si entre los archivos preparados hay algo que nunca debe
# subirse: secretos, claves o bases de datos.
#
# Para activarlo (una sola vez, tras clonar el repositorio):
#
#     git config core.hooksPath .githooks
#
# Solo mira NOMBRES de archivo, no su contenido: buscar secretos por patrones
# dentro del código genera falsos positivos, y un hook que molesta se acaba
# desactivando.

PELIGROSOS='(^|/)\.env$|(^|/)\.env\.|\.db$|\.db\.bak|\.sqlite3?$|\.pem$|\.key$|\.p12$|\.pfx$|\.crt$|(^|/)id_rsa|(^|/)id_ed25519|credenciales\.json$|credentials\.json$|(^|/)service-account'

encontrados=$(git diff --cached --name-only --diff-filter=ACM | grep -Ev '\.env\.example$' | grep -E "$PELIGROSOS")

if [ -n "$encontrados" ]; then
    echo ""
    echo "  COMMIT ABORTADO: estos archivos no deben subirse"
    echo ""
    echo "$encontrados" | sed 's/^/    /'
    echo ""
    echo "  Sácalos del área de preparación:"
    echo ""
    echo "$encontrados" | sed 's/^/    git restore --staged /'
    echo ""
    echo "  Y añade su patrón al .gitignore para que no vuelva a pasar."
    echo ""
    echo "  Si estás seguro de que es un falso positivo: git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
