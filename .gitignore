# ============================================
#  KAIZEN — .gitignore
#  Todo lo que aparece aquí NO se sube a GitHub
# ============================================

# --- SECRETOS Y CREDENCIALES (lo más importante) ---
# Los .env contienen datos sensibles (URLs, claves, tokens).
# NUNCA deben subirse a un repo público.
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Claves, certificados y credenciales. Todavía no existe ninguno en el
# proyecto: están aquí para que el día que aparezcan ya estén cubiertos.
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credenciales.json
credentials.json
service-account*.json

# --- BASE DE DATOS ---
# Tu base de datos local con tus datos personales.
*.db
*.sqlite
*.sqlite3
backend/kaizen.db

# Copias de seguridad de la base de datos (kaizen.db.bak-loquesea)
*.db.bak*

# --- PYTHON ---
__pycache__/
*.py[cod]
*.pyc
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Cobertura de tests
.coverage
htmlcov/

# --- NODE / FRONTEND ---
node_modules/
dist/
build/
.vite/
*.log
npm-debug.log*

# Caché incremental de TypeScript: se regenera en cada build
*.tsbuildinfo

# Service worker que genera vite-plugin-pwa en modo desarrollo
dev-dist/

# --- EDITOR / SISTEMA ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- VARIOS ---
*.tmp
*.bak

# --- NOTAS PERSONALES ---
Notas/
Claude.md
