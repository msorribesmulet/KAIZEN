# Plantilla de variables de entorno del backend.
# Copia este archivo como .env y rellena los valores reales.
# El .env real NUNCA se sube al repo (está en .gitignore).

# Ruta de la base de datos SQLite
DATABASE_URL=sqlite:///./kaizen.db

# Origen permitido para CORS (la URL del frontend en desarrollo)
FRONTEND_URL=http://localhost:5173

# Imprime en consola cada consulta SQL que ejecuta el ORM.
# Útil para depurar, pero incluye los valores de los parámetros (peso, edad...),
# así que en producción debe quedarse en false.
SQL_ECHO=false

# Nombre de la cookie de sesión y días que dura antes de caducar
SESSION_COOKIE_NAME=kaizen_session
SESSION_DAYS=7

# La cookie solo viaja por HTTPS. Déjalo en true: los navegadores tratan
# localhost como seguro, así que también funciona en desarrollo.
COOKIE_SECURE=true

# Debe quedarse en lax, y eso obliga a que el frontend y la API se sirvan
# desde el MISMO dominio (en local ya pasa: los dos son localhost).
#
# Si se despliegan en dominios distintos, la cookie pasa a ser de terceros:
# Safari la bloquea y Chrome la restringe, y además el JavaScript no puede
# leer la cookie CSRF de otro dominio, así que toda escritura daría 403.
# La solución NO es poner none, es servirlo todo bajo un mismo dominio
# (por ejemplo, redirigiendo /api al backend desde el frontend).
COOKIE_SAMESITE=lax

# Cookie del token CSRF. A diferencia de la de sesión, esta SÍ la lee el
# JavaScript del frontend, que la reenvía en la cabecera X-CSRF-Token.
CSRF_COOKIE_NAME=kaizen_csrf
