# Plantilla de variables de entorno del frontend.
# Copia este archivo como .env y rellena los valores reales.
# El .env real NUNCA se sube al repo (está en .gitignore).

# URL del backend al que se conecta el frontend
VITE_API_URL=http://localhost:8000

# Nombre de la cookie CSRF. Tiene que coincidir con CSRF_COOKIE_NAME del
# backend: el frontend la lee para reenviarla en la cabecera X-CSRF-Token.
VITE_CSRF_COOKIE=kaizen_csrf
